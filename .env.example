# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server Configuration
PORT=3000
NODE_ENV="development"
ALLOWED_ORIGIN="*"

# Client Frontend (Netlify Deployment)
# Set this in Netlify Environment Variables to your deployed Node.js backend URL
# Leave empty if backend is hosted on the same domain or if using netlify.toml proxy
VITE_API_URL="https://your-vnit-hostel-backend.onrender.com"

# JWT Authentication Secret (Use a strong random 256-bit string in production)
JWT_SECRET="vnit_hostel_admin_jwt_secret_key_change_in_production_2026"
JWT_EXPIRES_IN="24h"

# MySQL Database Configuration
# Connect to local MySQL or cloud MySQL (Railway, Aiven, Supabase/RDS, etc.)
# If left empty or unreachable, the system automatically falls back to built-in relational memory engine with sample VNIT data
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="your_mysql_password"
MYSQL_DATABASE="vnit_hostel_db"
MYSQL_SSL=false

